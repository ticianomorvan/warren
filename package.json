{
  "name": "warren",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @warren/db generate",
    "db:migrate": "pnpm --filter @warren/db migrate",
    "db:tenancy-check": "tsx scripts/db-tenancy-check.ts",
    "mail:verify": "tsx --env-file-if-exists=apps/web/.env.local scripts/mail-verify.ts",
    "mail:status": "tsx --env-file-if-exists=apps/web/.env.local scripts/mail-status.ts",
    "mail:reingest": "tsx --env-file-if-exists=apps/web/.env.local --env-file-if-exists=.vercel/.env.development.local scripts/mail-reingest.ts",
    "mailbox:add": "tsx --env-file-if-exists=apps/web/.env.local scripts/mailbox-add.ts",
    "mail:replay-unrouted": "tsx --env-file-if-exists=apps/web/.env.local --env-file-if-exists=.vercel/.env.development.local scripts/mail-replay-unrouted.ts",
    "user:erase": "tsx --env-file-if-exists=apps/web/.env.local --env-file-if-exists=.vercel/.env.development.local scripts/user-erase.ts",
    "mail:parse-pending": "tsx --env-file-if-exists=apps/web/.env.local --env-file-if-exists=.vercel/.env.development.local scripts/mail-parse-pending.ts",
    "ledger:accounts": "tsx --env-file-if-exists=apps/web/.env.local scripts/ledger-accounts.ts",
    "ledger:status": "tsx --env-file-if-exists=apps/web/.env.local scripts/ledger-status.ts",
    "notice:status": "tsx --env-file-if-exists=apps/web/.env.local scripts/notice-status.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "^24.0.0",
    "@warren/core": "workspace:*",
    "@warren/db": "workspace:*",
    "tsx": "^4.20.0",
    "turbo": "2.11.11",
    "typescript": "7.0.2",
    "@vercel/blob": "2.9.0"
  }
}
