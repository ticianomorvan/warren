{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!**/drizzle/meta", "!**/next-env.d.ts"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" } },
  "linter": { "enabled": true, "rules": { "preset": "none" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": ["packages/core/src/**", "!packages/core/src/**/adapters/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**",
                      "!./**",
                      "!../**",
                      "!node:*",
                      "!mailauth",
                      "!postal-mime",
                      "!linkedom"
                    ],
                    "message": "Core imports only relative paths, node:* and the allow-listed packages. A vendor SDK belongs inside an adapter (packages/core/src/**/adapters/); a new core dependency must be added to this allow-list in biome.json."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
