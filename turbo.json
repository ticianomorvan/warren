{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_URL_MIGRATIONS",
    "DATABASE_URL_AUTH",
    "DATABASE_URL_ERASER",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "WARREN_SIGNUP_EMAILS",
    "RESEND_API_KEY",
    "RESEND_WEBHOOK_SECRET",
    "WARREN_MASTER_KEY",
    "WARREN_MASTER_KEY_VERSION",
    "WARREN_MASTER_KEY_PREVIOUS",
    "WARREN_KAPSO_USER_ID",
    "VAPID_PUBLIC_KEY",
    "VAPID_PRIVATE_KEY",
    "VAPID_SUBJECT",
    "WARREN_RAW_STORE_DIR",
    "BLOB_READ_WRITE_TOKEN",
    "VERCEL",
    "KAPSO_API_KEY",
    "KAPSO_PHONE_NUMBER_ID",
    "WARREN_OWNER_WHATSAPP",
    "KAPSO_WEBHOOK_SECRET",
    "KAPSO_NOTICE_TEMPLATE",
    "KAPSO_NOTICE_TEMPLATE_LANGUAGE",
    "BLOB_STORE_ID",
    "VERCEL_OIDC_TOKEN"
  ]
}
