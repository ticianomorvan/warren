# Copy to apps/web/.env.local for local work. On Vercel, set these as environment variables.

# App connection: the warren_app role (reads and appends, under row-level security), pooled Neon URL.
DATABASE_URL=postgres://warren_app:PASSWORD@HOST-pooler/neondb?sslmode=require
# Migrations and operator scripts (ledger:accounts, mailbox:add): the owner role, direct
# (unpooled) Neon URL. Never set this on Vercel.
DATABASE_URL_MIGRATIONS=postgres://OWNER:PASSWORD@HOST/neondb?sslmode=require
# Better Auth (step 2 of slice 1): the warren_auth role, which can touch the four auth tables
# and nothing else. Pooled URL.
# DATABASE_URL_AUTH=postgres://warren_auth:PASSWORD@HOST-pooler/neondb?sslmode=require
# Erasing a user (pnpm user:erase): the warren_eraser role, which can delete one user's
# derived rows and key and nothing else. Never set this on Vercel.
# DATABASE_URL_ERASER=postgres://warren_eraser:PASSWORD@HOST-pooler/neondb?sslmode=require

# Master key that wraps every user's data key: 32 random bytes, base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes every user's sealed data unreadable; keep a copy outside Vercel. To rotate,
# set the new key here with a higher WARREN_MASTER_KEY_VERSION and list the old ones as
# WARREN_MASTER_KEY_PREVIOUS=1=<old base64>[,2=...]; keys wrapped by an old one keep opening.
WARREN_MASTER_KEY=
# WARREN_MASTER_KEY_VERSION=1
# WARREN_MASTER_KEY_PREVIOUS=

# Resend: API key with read access to received emails, and the webhook's signing secret.
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...

# Mail is routed by the To header to the user who registered that address:
#   pnpm mailbox:add --user <user id> you@example.com

# Kapso (WhatsApp): API key and the phone number ID of Warren's WhatsApp number.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
# Signing secret of the Kapso webhook that reports delivery (POST /api/inbound/kapso).
KAPSO_WEBHOOK_SECRET=
# Approved WhatsApp template with one body variable, used when the 24-hour window is closed.
# KAPSO_NOTICE_TEMPLATE=
# KAPSO_NOTICE_TEMPLATE_LANGUAGE=es_AR

# The WhatsApp number notices go to, digits only, international format (Argentina: 549 + area +
# number), and the one user it belongs to. Other users' notices are not sent here (slice 3
# replaces this channel with push).
WARREN_OWNER_WHATSAPP=549351XXXXXXX
WARREN_KAPSO_USER_ID=

# Vercel Blob (private store). On Vercel, connecting the store sets BLOB_STORE_ID and access
# works through short-lived OIDC credentials. Locally, get them with:
#   pnpm dlx vercel env pull .vercel/.env.development.local
# Local alternative: write raw mail to this directory instead of Vercel Blob.
# WARREN_RAW_STORE_DIR=../../.data
